# Copie para .env.local (desenvolvimento) — nunca commite valores reais.
# Em produção, variáveis públicas ficam em wrangler.jsonc ("vars") e segredos em `wrangler secret put`.

# --- Aplicação ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Supabase (chave publicável; pode ir ao navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Segredo do servidor (SEGREDO) ---
# Gere com `openssl rand -hex 32` e registre o hash no banco:
#   select app_private.set_server_secret('<valor>');
WW_SERVER_SECRET=
# Autentica as chamadas do Cron Trigger às rotas /api/cron/*
CRON_SECRET=

# --- Mercado Livre (SEGREDO) — https://developers.mercadolivre.com.br/devcenter ---
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# --- HeroPay (SEGREDO) — sandbox: https://api.beta.heropay.tech | produção: https://api.heropay.tech ---
HEROPAY_API_URL=https://api.beta.heropay.tech
HEROPAY_JWT_TOKEN=
HEROPAY_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (opcional; site key é pública) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- IA ---
# workers-ai (binding AI na Cloudflare) | openai-compatible (qualquer API /chat/completions, inclusive Ollama remoto)
AI_PROVIDER=workers-ai
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_BASE_URL=
AI_API_KEY=
